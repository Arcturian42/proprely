                  "Customer service sur mesure avec interlocuteur dedie",
                  "Onboarding personnalise — un membre de l'equipe vous accompagne",
                  "Acces direct a l'equipe produit par telephone",
                  "Influence sur la roadmap et les fonctionnalites",
                  "Construction du logiciel selon vos besoins terrain reels",
                ].map((b, i) => (
                  <div key={i} className="flex items-center gap-2 text-sm text-white/90">
                    <CheckCircle className="w-4 h-4 text-[#00C2E0] shrink-0" />
                    {b}
                  </div>
                ))}
              </div>

              {/* Objection levee */}
              <div className="bg-white/5 rounded-xl p-4 mb-6 text-center">
                <p className="text-white/70 text-sm">
                  <strong className="text-white">Vous ne devenez pas actionnaire.</strong> Vous restez utilisatrice avec un tarif privilegie et un accompagnement premium. C'est tout.
                </p>
              </div>

              <div className="text-center">
                <Button
                  size="lg"
                  onClick={scrollToForm}
                  className="bg-[#00C2E0] hover:bg-[#00a8c2] text-[#0F2D5E] rounded-full px-10 text-base font-bold shadow-lg"
                >
                  Candidater — 49€/mois a vie
                  <ArrowRight className="w-5 h-5 ml-2" />
                </Button>
                <p className="text-white/40 text-xs mt-3">
                  Sans engagement · Periode d'essai incluse · Annulation a tout moment
                </p>
              </div>
            </CardContent>
          </Card>
        </div>
      </div>
    </section>
  );
}

